[Unit]
Description=Vortix passive daemon candidate (user service)
Documentation=https://github.com/Harry-kp/vortix
After=network.target

[Service]
Type=simple
ExecStart=/usr/libexec/vortix/vortix daemon
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=true
StandardOutput=journal
StandardError=journal

# Install this file in a user's systemd unit directory. Packages stage it but
# MUST NOT enable or start it automatically. U10 is read-only and unprivileged.
[Install]
WantedBy=default.target
