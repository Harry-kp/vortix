# Reference copy of the unit `sudo vortix service install` generates.
# Replace the <PLACEHOLDER> values if installing by hand; prefer the
# installer, which bakes them in and enables the service at boot.
[Unit]
Description=Vortix VPN engine daemon
Documentation=https://github.com/Harry-kp/vortix
After=network.target

[Service]
Type=simple
ExecStart=<VORTIX_BINARY> daemon --socket /var/run/vortix.sock
Restart=on-failure
RestartSec=5
# The daemon runs as root for privileged subprocess work (wg-quick,
# openvpn, firewall rules) and serves its unprivileged owner over the
# peer-credential-authenticated Unix socket (P2 owner auth).
User=root
Group=root
Environment=VORTIX_OWNER_UID=<OWNER_UID>
Environment=VORTIX_CONFIG_DIR=<OWNER_CONFIG_DIR>
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
