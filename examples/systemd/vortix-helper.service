[Unit]
Description=Vortix privileged helper (inactive U11 template)
Documentation=https://github.com/Harry-kp/vortix
After=local-fs.target
ConditionPathExists=/var/lib/vortix/enrollment/enrolled

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=vortix
RuntimeDirectoryMode=0700
StateDirectory=vortix
StateDirectoryMode=0700
ExecStart=/usr/libexec/vortix/vortix-helper --serve
Restart=no
UMask=0077
StandardOutput=journal
StandardError=journal

# The U11 binary rejects --serve with EX_CONFIG (78). U12 implements the
# reviewed server; U13 alone may create the enrollment marker and enable it.
