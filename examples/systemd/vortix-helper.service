[Unit]
Description=Vortix privileged helper (inactive U11 template)
Documentation=https://github.com/Harry-kp/vortix
After=local-fs.target
ConditionPathExists=/var/lib/vortix/enrollment.json

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=vortix
RuntimeDirectoryMode=0711
StateDirectory=vortix
StateDirectoryMode=0700
ExecStart=/usr/libexec/vortix/vortix-helper --serve
Restart=no
UMask=0077
StandardOutput=journal
StandardError=journal

# The staged server exposes only an authenticated handshake and rejects every
# operation. U13 alone may enable the service and promote enrolled authority.
