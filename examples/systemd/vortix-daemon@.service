[Unit]
Description=Vortix enrolled daemon for %i (inactive U11 template)
Documentation=https://github.com/Harry-kp/vortix
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/vortix/enrollment.json

[Service]
Type=simple
User=%i
RuntimeDirectory=vortix-%i
RuntimeDirectoryMode=0700
Environment=VORTIX_DAEMON_SOCKET=/run/vortix-%i/daemon.sock
EnvironmentFile=/var/lib/vortix/daemon.env
ExecStart=/usr/libexec/vortix/vortix daemon
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=true
StandardOutput=journal
StandardError=journal

# A package may install this template but MUST NOT enable an instance. U13
# enrollment owns enablement and login-independent lifecycle policy.
[Install]
WantedBy=multi-user.target
