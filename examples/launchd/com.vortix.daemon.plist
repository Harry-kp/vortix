<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vortix.daemon</string>
    <key>Disabled</key>
    <true/>
    <!-- Package tooling replaces this placeholder only after validating the
         non-root enrollment owner. Never load this example verbatim. -->
    <key>UserName</key>
    <string>VORTIX_ENROLLED_USER</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/Vortix/bin/vortix</string>
        <string>daemon</string>
        <string>--socket</string>
        <string>/var/run/vortix/daemon.sock</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/var/log/vortix-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/vortix-daemon.log</string>
</dict>
</plist>
